name: Opportunity Hunter Discovery

on:
  schedule:
    - cron: "0 6 * * *" # Daily at 06:00 UTC
  workflow_dispatch:

permissions:
  contents: write

jobs:
  hunt:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Run discovery & scoring
        run: npm run discover

      - name: Commit updated opportunity feed
        run: |
          git config user.name "opportunity-hunter-bot"
          git config user.email "bot@users.noreply.github.com"
          git add src/data/opportunities.json
          if ! git diff --cached --quiet; then
            git commit -m "chore(data): update discovered opportunities [skip ci]"
            git push
          fi

.github/workflows/pages.yml
name: Deploy PWA to GitHub Pages

on:
  push:
    branches: ["main"]
    paths:
      - "src/**"
      - "scripts/**"
      - "package.json"
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  build:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Build static PWA
        run: ./scripts/build-and-deploy.sh --build-only

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: "dist"

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4

