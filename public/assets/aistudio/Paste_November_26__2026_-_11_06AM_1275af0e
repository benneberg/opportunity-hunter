const STORAGE_KEY = "opp_hunter_state_v1";

const SEED_ITEMS = [
  {
    id: "seed-alignerr",
    title: "Technical AI Model Evaluator & Coding Trainer",
    organization: "Alignerr",
    category: "Research & Model Evaluation",
    location: "Remote / Sweden check",
    url: "https://www.alignerr.com",
    summary: "Evaluate LLM outputs, code reasoning, and instruction following.",
    tags: ["llm", "evaluation", "coding"],
    score: 86,
    eligibility: "likely_eligible",
    rationale: "Matches technical evaluation + coding + remote/Sweden check",
    workflowStatus: "saved"
  },
  {
    id: "seed-prolific",
    title: "AI & Human-in-the-Loop Research Studies",
    organization: "Prolific",
    category: "Research & Model Evaluation",
    location: "Remote / Sweden supported",
    url: "https://www.prolific.com",
    summary: "Paid academic and industry research tasks including model evaluation.",
    tags: ["research", "evaluation", "sweden"],
    score: 82,
    eligibility: "confirmed_eligible",
    rationale: "Sweden supported; flexible research participation",
    workflowStatus: "new"
  }
];

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch (_) {}
  return { items: SEED_ITEMS, updatedAt: null };
}

function saveState(state) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}

function computeScore(item) {
  const text = `${item.title} ${item.organization} ${item.location} ${item.summary} ${(item.tags || []).join(" ")}`.toLowerCase();
  const keywords = ["llm", "eval", "evaluation", "agent", "code", "coding", "python", "typescript", "research", "grant", "credits", "sweden", "remote"];
  const hits = keywords.filter((k) => text.includes(k));
  const score = Math.min(98, 45 + hits.length * 7);

  let eligibility = "uncertain";
  if (text.includes("sweden")) eligibility = "confirmed_eligible";
  else if (text.includes("remote") || text.includes("international")) eligibility = "likely_eligible";

  return {
    score,
    eligibility,
    rationale: `Signals: ${hits.join(", ") || "manual entry"} · Eligibility: ${eligibility}`
  };
}

let state = loadState();

async function mergeRemoteFeed() {
  try {
    const res = await fetch("./data/opportunities.json", { cache: "no-store" });
    if (!res.ok) return;
    const data = await res.json();
    if (!Array.isArray(data.items) || data.items.length === 0) return;

    const existingIds = new Set(state.items.map((i) => i.id));
    for (const remoteItem of data.items) {
      if (!existingIds.has(remoteItem.id)) {
        state.items.unshift(remoteItem);
      }
    }
    state.updatedAt = data.updatedAt || state.updatedAt;
    saveState(state);
  } catch (_) {}
}

function render() {
  const q = document.getElementById("searchInput").value.trim().toLowerCase();
  const statusFilter = document.getElementById("statusFilter").value;

  const filtered = state.items.filter((item) => {
    if (statusFilter !== "all" && item.workflowStatus !== statusFilter) return false;
    if (!q) return true;
    const hay = `${item.title} ${item.organization} ${item.category} ${item.location} ${item.summary} ${(item.tags || []).join(" ")}`.toLowerCase();
    return hay.includes(q);
  });

  const strongCount = state.items.filter((i) => (i.score || 0) >= 80 && i.workflowStatus !== "dismissed").length;
  const savedCount = state.items.filter((i) => ["saved", "preparing", "applied"].includes(i.workflowStatus)).length;

  document.getElementById("stats").innerHTML = `
    <div class="stat"><span>Tracked</span><strong>${state.items.length}</strong></div>
    <div class="stat"><span>Strong Matches</span><strong>${strongCount}</strong></div>
    <div class="stat"><span>Active Pipeline</span><strong>${savedCount}</strong></div>
  `;

  document.getElementById("syncMeta").textContent = state.updatedAt
    ? `Last feed sync: ${new Date(state.updatedAt).toLocaleString()} · Offline PWA`
    : "Local + offline-ready SPA PWA";

  const listEl = document.getElementById("oppList");
  if (!filtered.length) {
    listEl.innerHTML = `<p class="muted">No matching opportunities.</p>`;
    return;
  }

  listEl.innerHTML = filtered
    .map(
      (item) => `
      <article class="opp-item">
        <div class="opp-head">
          <div>
            <strong>${escapeHtml(item.title)}</strong> — <span class="muted">${escapeHtml(item.organization)}</span>
          </div>
          <span class="badge">${item.score ?? 50}% fit · ${escapeHtml(item.workflowStatus)}</span>
        </div>
        <div class="opp-meta">
          <span>${escapeHtml(item.category)}</span>
          <span>${escapeHtml(item.location || "Location TBD")}</span>
          <span>Eligibility: ${escapeHtml(item.eligibility || "uncertain")}</span>
        </div>
        <p class="muted">${escapeHtml(item.summary || "")}</p>
        <p class="muted">${escapeHtml(item.rationale || "")}</p>
        <div class="opp-actions">
          ${item.url ? `<a class="btn-like" href="${escapeAttr(item.url)}" target="_blank" rel="noopener noreferrer">Open</a>` : ""}
          <button type="button" data-act="saved" data-id="${escapeAttr(item.id)}">Save</button>
          <button type="button" data-act="applied" data-id="${escapeAttr(item.id)}">Mark Applied</button>
          <button type="button" data-act="dismissed" data-id="${escapeAttr(item.id)}">Dismiss</button>
        </div>
      </article>`
    )
    .join("");
}

function escapeHtml(s) {
  return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}

function escapeAttr(s) {
  return escapeHtml(s);
}

document.getElementById("oppForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const fd = new FormData(e.target);
  const base = {
    id: `manual-${Date.now()}`,
    title: String(fd.get("title") || "").trim(),
    organization: String(fd.get("organization") || "").trim(),
    category: String(fd.get("category") || "Recruitment & Contracting"),
    location: String(fd.get("location") || "Unknown").trim(),
    url: String(fd.get("url") || "").trim(),
    tags: String(fd.get("tags") || "").split(",").map((t) => t.trim()).filter(Boolean),
    summary: String(fd.get("summary") || "").trim(),
    workflowStatus: "saved"
  };
  const scored = computeScore(base);
  state.items.unshift({ ...base, ...scored });
  saveState(state);
  e.target.reset();
  render();
});

document.getElementById("oppList").addEventListener("click", (e) => {
  const btn = e.target.closest("button[data-act]");
  if (!btn) return;
  const id = btn.dataset.id;
  const act = btn.dataset.act;
  const target = state.items.find((i) => i.id === id);
  if (!target) return;
  target.workflowStatus = act;
  saveState(state);
  render();
});

document.getElementById("searchInput").addEventListener("input", render);
document.getElementById("statusFilter").addEventListener("change", render);

document.getElementById("exportBtn").addEventListener("click", () => {
  const blob = new Blob([JSON.stringify(state, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "opportunity-hunter-backup.json";
  a.click();
  URL.revokeObjectURL(url);
});

document.getElementById("importInput").addEventListener("change", async (e) => {
  const file = e.target.files?.[0];
  if (!file) return;
  const parsed = JSON.parse(await file.text());
  if (Array.isArray(parsed.items)) {
    state = { items: parsed.items, updatedAt: parsed.updatedAt || new Date().toISOString() };
    saveState(state);
    render();
  }
});

if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => navigator.serviceWorker.register("./sw.js").catch(() => {}));
}

render();
mergeRemoteFeed().then(render);

