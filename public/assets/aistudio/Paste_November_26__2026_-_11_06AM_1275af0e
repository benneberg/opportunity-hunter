#!/usr/bin/env bash
set -euo pipefail

BUILD_ONLY=false
if [[ "${1:-}" == "--build-only" ]]; then
  BUILD_ONLY=true
fi

rm -rf dist
mkdir -p dist/data

cp src/index.html dist/index.html
cp src/manifest.json dist/manifest.json
cp src/sw.js dist/sw.js
cp src/styles.css dist/styles.css
cp src/app.js dist/app.js

if [[ -f src/data/opportunities.json ]]; then
  cp src/data/opportunities.json dist/data/opportunities.json
else
  echo '{"updatedAt":null,"items":[]}' > dist/data/opportunities.json
fi

# Cache-bust asset version using short git SHA or timestamp
VERSION="$(git rev-parse --short HEAD 2>/dev/null || date +%s)"
sed -i.bak "s/__APP_VERSION__/${VERSION}/g" dist/sw.js dist/index.html && rm -f dist/*.bak

echo "Built static PWA into ./dist (version: ${VERSION})"

if [[ "$BUILD_ONLY" == true ]]; then
  exit 0
fi

# Optional local/direct gh-pages push if not running inside GitHub Actions Pages artifact flow
if command -v gh >/dev/null 2>&1 && git remote get-url origin >/dev/null 2>&1; then
  WORKTREE_DIR="$(mktemp -d)"
  trap 'git worktree remove --force "$WORKTREE_DIR" >/dev/null 2>&1 || true' EXIT
  git fetch origin gh-pages || true
  if git show-ref --verify --quiet refs/remotes/origin/gh-pages; then
    git worktree add "$WORKTREE_DIR" origin/gh-pages
  else
    git worktree add --orphan -b gh-pages "$WORKTREE_DIR"
  fi
  rm -rf "${WORKTREE_DIR:?}"/*
  cp -r dist/* "$WORKTREE_DIR"/
  touch "$WORKTREE_DIR/.nojekyll"
  (
    cd "$WORKTREE_DIR"
    git add -A
    if ! git diff --cached --quiet; then
      git commit -m "chore(pages): deploy Opportunity Hunter ${VERSION}"
      git push origin gh-pages
    fi
  )
  echo "Deployed ./dist to gh-pages branch."
else
  echo "Skipped gh-pages push (use GitHub Actions workflow .github/workflows/pages.yml in CI)."
fi

