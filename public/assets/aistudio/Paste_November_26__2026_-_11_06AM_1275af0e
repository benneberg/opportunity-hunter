scripts/discover.mjs
Runs in GitHub Actions (or locally) to fetch RSS/JSON feeds from a curated source list, normalize items, compute deterministic relevance against your profile, and write dist/data/opportunities.json (and src/data/opportunities.json for local dev).
import fs from "node:fs";
import path from "node:path";

const SOURCES = [
  // Add verified RSS/Atom or JSON endpoints here, e.g.:
  // { id: "anthropic-eng", name: "Anthropic Jobs", type: "rss", url: "https://...", category: "Recruitment & Contracting", regionHint: "international" }
];

const PROFILE = {
  skills: ["llm", "evaluation", "agents", "typescript", "python", "iot", "debugging", "ast", "developer-tooling"],
  preferredLocations: ["remote", "sweden", "europe", "international"],
  blockedLocations: []
};

function scoreOpportunity(item) {
  const text = `${item.title} ${item.summary} ${(item.tags || []).join(" ")}`.toLowerCase();
  const matchedSkills = PROFILE.skills.filter((s) => text.includes(s));
  const skillScore = Math.min(30, Math.round((matchedSkills.length / 4) * 30));

  const loc = (item.location || "unknown").toLowerCase();
  let eligibility = "uncertain";
  let eligScore = 10;

  if (PROFILE.blockedLocations.some((b) => loc.includes(b))) {
    eligibility = "ineligible";
    eligScore = 0;
  } else if (loc.includes("sweden") || loc.includes("remote") || loc.includes("international")) {
    eligibility = loc.includes("sweden") ? "confirmed_eligible" : "likely_eligible";
    eligScore = loc.includes("sweden") ? 25 : 20;
  }

  const prefScore = 15;
  const techScore = matchedSkills.length > 0 ? 15 : 6;
  const urgencyScore = 7;
  const total = Math.min(100, skillScore + eligScore + prefScore + techScore + urgencyScore);

  return {
    score: total,
    eligibility,
    matchedSkills,
    rationale: `Matched [${matchedSkills.join(", ") || "general AI"}] · Eligibility: ${eligibility}`
  };
}

function parseRssItems(xml, source) {
  const itemMatches = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/gi)];
  return itemMatches.map((m, idx) => {
    const block = m[1];
    const title = (block.match(/<title>(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?<\/title>/i)?.[1] || "Untitled").trim();
    const link = (block.match(/<link>([\s\S]*?)<\/link>/i)?.[1] || source.url).trim();
    const desc = (block.match(/<description>(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?<\/description>/i)?.[1] || "")
      .replace(/<[^>]+>/g, " ")
      .replace(/\s+/g, " ")
      .trim();

    return {
      id: `${source.id}-${idx}-${Buffer.from(link).toString("base64url").slice(0, 10)}`,
      title,
      organization: source.name,
      category: source.category || "Recruitment & Contracting",
      location: source.location || "Remote / Check listing",
      url: link,
      summary: desc.slice(0, 280),
      tags: [source.id],
      externalStatus: "open",
      workflowStatus: "new",
      discoveredAt: new Date().toISOString().slice(0, 10)
    };
  });
}

async function run() {
  const discovered = [];

  for (const src of SOURCES) {
    try {
      const res = await fetch(src.url, { headers: { "User-Agent": "OpportunityHunterBot/1.0" } });
      if (!res.ok) continue;
      const body = await res.text();
      const parsed = src.type === "rss" ? parseRssItems(body, src) : [];
      for (const item of parsed) {
        const assessment = scoreOpportunity(item);
        discovered.push({ ...item, ...assessment });
      }
    } catch (err) {
      console.warn(`Source fetch skipped (${src.id}):`, err.message);
    }
  }

  const outPaths = [
    path.resolve("src/data/opportunities.json"),
    path.resolve("dist/data/opportunities.json")
  ];

  for (const out of outPaths) {
    fs.mkdirSync(path.dirname(out), { recursive: true });
    fs.writeFileSync(out, JSON.stringify({ updatedAt: new Date().toISOString(), items: discovered }, null, 2));
  }

  console.log(`Discovery complete. Items processed: ${discovered.length}`);
}

run();

